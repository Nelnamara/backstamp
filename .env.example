# Copy to .env and fill in real values. Never commit .env itself.

# App runtime connection — use Neon's pooled ("-pooler") host here.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Used only for Alembic migrations — use Neon's direct (non-pooled) host here.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Where uploaded item photos are stored on disk, relative to the repo root.
PHOTO_STORAGE_DIR=storage/photos

# Resend API key — used to send magic-link sign-in emails. Get one at resend.com.
RESEND_API_KEY=re_your_key_here

# Must be a verified sending domain in Resend, or the sandbox default below
# (which only delivers to the email on your own Resend account).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where magic-link emails point back to — the web app's own origin.
FRONTEND_URL=http://localhost:5173
